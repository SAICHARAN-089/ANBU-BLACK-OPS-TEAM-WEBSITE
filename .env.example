# ============================================================
# ANBU BLACK OPS — environment template
# ------------------------------------------------------------
# Copy this file to `.env` ONLY if you need to point the app at a
# different Supabase project. By default the app already uses the
# project in lib/config.js with its publishable key — that key is
# public by design and safe to ship in the repo.
#
#   SUPABASE_URL  -> https://<your-project-ref>.supabase.co
#   SUPABASE_KEY  -> your project's publishable / anon key
#                    (Project Settings -> API)
#
# Optional extra env vars respected by the code:
#   SUPABASE_ANON_KEY          (alias for SUPABASE_KEY)
#   SUPABASE_PUBLISHABLE_KEY   (alias for SUPABASE_KEY)
#   KV_REST_API_URL            (legacy Vercel KV backend)
#   KV_REST_API_TOKEN          (legacy Vercel KV backend)
# ============================================================

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key
